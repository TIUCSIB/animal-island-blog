# ─── 前端环境变量（构建时写入） ───
# 开发时放在 .env.local，部署时在 Cloudflare Pages 的 Environment variables 里设置

# API 后端地址（本地开发用 http://localhost:8787）
VITE_API_BASE_URL=https://shlii-api.你的域名.workers.dev

# Turnstile 人机验证（不需要可关闭）
VITE_ENABLE_TURNSTILE=false
VITE_TURNSTILE_SITE_KEY=你的_Turnstile_Site_Key

# ─── 后端环境变量（Cloudflare Worker 用） ───
# 开发时放在 .dev.vars，部署时用 wrangler secret put 设置

# ADMIN_PASSWORD=管理员密码
# TURNSTILE_ENABLED=false
# TURNSTILE_SECRET_KEY=你的_Turnstile_Secret_Key
# CLOUDINARY_CLOUD_NAME=你的_cloud_name
# CLOUDINARY_API_KEY=你的_api_key
# CLOUDINARY_API_SECRET=你的_api_secret
# CLOUDINARY_UPLOAD_FOLDER=animal-island-blog
