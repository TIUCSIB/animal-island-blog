# ========================
# Frontend env vars
# ========================
# Local: put these in .env.local
# Production: configure them in Cloudflare Pages

VITE_API_BASE_URL=https://your-api-domain.workers.dev
VITE_ENABLE_TURNSTILE=false
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key

# ========================
# Backend env vars
# ========================
# Local: put these in .dev.vars
# Production: configure secrets with `wrangler secret put`
# Non-secret values can be configured in Wrangler vars or the Cloudflare dashboard

ADMIN_PASSWORD=replace-with-a-strong-password
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
MUSIC_API_BASE_URL=https://music.030456.xyz/api
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_FOLDER=animal-island-blog
